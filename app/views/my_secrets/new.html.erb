<% content_for :title, "Novo Segredo - Secrets Box" %>
<% content_for :page_title, "Novo Segredo" %>

<div class="row">
  <div class="col-md-8">
    <div class="card">
      <div class="card-body">
        <%= form_with(model: @my_secret, local: true) do |f| %>
          <% if @my_secret.errors.any? %>
            <div class="alert alert-danger">
              <h6 class="alert-heading">Foram encontrados os seguintes erros:</h6>
              <ul class="mb-0">
                <% @my_secret.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="mb-3">
            <%= f.label :category, "Categoria", class: "form-label" %>
            <%= f.select :category, MySecret.categories_for_select, {}, class: "form-select" %>
          </div>

          <div class="mb-3">
            <%= f.label :title, "Título", class: "form-label" %>
            <%= f.text_field :title, class: "form-control", placeholder: "Ex: Gmail Principal" %>
          </div>

          <div class="mb-3">
            <%= f.label :description, "Descrição", class: "form-label" %>
            <%= f.text_area :description, class: "form-control", rows: 3, placeholder: "Uma breve descrição..." %>
          </div>

          <div class="mb-3">
            <%= f.label :url, "URL", class: "form-label" %>
            <%= f.url_field :url, class: "form-control", placeholder: "https://..." %>
          </div>

          <div class="mb-3">
            <%= f.label :username, "Usuário", class: "form-label" %>
            <%= f.text_field :username, class: "form-control", placeholder: "Seu nome de usuário" %>
          </div>

          <div class="mb-3">
            <%= f.label :password, "Senha", class: "form-label" %>
            <div class="input-group">
              <%= f.password_field :password, class: "form-control", placeholder: "Sua senha" %>
              <button type="button" class="btn btn-outline-secondary" onclick="togglePassword(this)">
                <i class="fas fa-eye"></i>
              </button>
            </div>
          </div>

          <div class="d-flex justify-content-between">
            <%= link_to "Cancelar", my_secrets_path, class: "btn btn-outline-secondary" %>
            <%= f.submit "Salvar", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title">Dicas</h5>
        <ul class="list-unstyled mb-0">
          <li class="mb-2">
            <i class="fas fa-info-circle text-primary me-2"></i>
            Escolha um título descritivo
          </li>
          <li class="mb-2">
            <i class="fas fa-info-circle text-primary me-2"></i>
            Use senhas fortes e únicas
          </li>
          <li>
            <i class="fas fa-info-circle text-primary me-2"></i>
            Mantenha suas informações atualizadas
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>

<script>
function togglePassword(button) {
  const passwordField = button.parentElement.querySelector('input[type="password"]');
  const icon = button.querySelector('i');
  
  if (passwordField.type === "password") {
    passwordField.type = "text";
    icon.classList.remove("fa-eye");
    icon.classList.add("fa-eye-slash");
  } else {
    passwordField.type = "password";
    icon.classList.remove("fa-eye-slash");
    icon.classList.add("fa-eye");
  }
}
</script> 