<% content_for :title, "Senhas & Arquivos - Secrets Box" %>
<% content_for :page_title, "Senhas & Arquivos" %>

<div class="card">
  <div class="card-header bg-white">
    <div class="d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0">
            <i class="fas fa-search text-muted"></i>
          </span>
          <input type="text" class="form-control border-start-0" placeholder="Buscar..." data-controller="search">
        </div>
      </div>

      <div>
        <%= link_to new_my_secret_path, class: "btn btn-primary" do %>
          <i class="fas fa-plus me-2"></i> Novo
        <% end %>
      </div>
    </div>
  </div>

  <div class="card-body p-0">
    <% if @my_secrets.any? %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Título</th>
              <th>Categoria</th>
              <th>Última Atualização</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @my_secrets.each do |secret| %>
              <tr>
                <td>
                  <div class="d-flex align-items-center">
                    <i class="fas <%= secret.category == 'file' ? 'fa-file' : 'fa-key' %> me-2 text-muted"></i>
                    <%= secret.title %>
                  </div>
                </td>
                <td><%= t("my_secrets.categories.#{secret.category}") %></td>
                <td><%= time_ago_in_words(secret.updated_at) %></td>
                <td>
                  <div class="btn-group">
                    <%= link_to my_secret_path(secret), class: "btn btn-sm btn-outline-primary" do %>
                      <i class="fas fa-eye"></i>
                    <% end %>
                    <%= link_to edit_my_secret_path(secret), class: "btn btn-sm btn-outline-secondary" do %>
                      <i class="fas fa-edit"></i>
                    <% end %>
                    <%= button_to my_secret_path(secret), method: :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Tem certeza?" } do %>
                      <i class="fas fa-trash"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-5">
        <i class="fas fa-lock fa-3x text-muted mb-3"></i>
        <p class="mb-0">Você ainda não tem nenhuma senha ou arquivo salvo.</p>
        <%= link_to "Criar Novo", new_my_secret_path, class: "btn btn-primary mt-3" %>
      </div>
    <% end %>
  </div>
</div> 