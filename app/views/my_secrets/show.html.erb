<% content_for :title, "#{@my_secret.title} - Secrets Box" %>
<% content_for :page_title, @my_secret.title %>

<div class="row">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <div>
          <span class="badge bg-primary me-2">
            <i class="fas <%= @my_secret.category == 'file' ? 'fa-file' : 'fa-key' %> me-1"></i>
            <%= t("my_secrets.categories.#{@my_secret.category}") %>
          </span>
          <small class="text-muted">
            Criado <%= time_ago_in_words(@my_secret.created_at) %> atrás
          </small>
        </div>
        <div>
          <%= link_to edit_my_secret_path(@my_secret), class: "btn btn-sm btn-outline-primary me-2" do %>
            <i class="fas fa-edit"></i> Editar
          <% end %>
          <%= button_to my_secret_path(@my_secret), method: :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Tem certeza?" } do %>
            <i class="fas fa-trash"></i> Excluir
          <% end %>
        </div>
      </div>
      
      <div class="card-body">
        <% if @my_secret.description.present? %>
          <div class="mb-4">
            <h6 class="text-muted mb-2">Descrição</h6>
            <p class="mb-0"><%= @my_secret.description %></p>
          </div>
        <% end %>

        <% if @my_secret.url.present? %>
          <div class="mb-4">
            <h6 class="text-muted mb-2">URL</h6>
            <%= link_to @my_secret.url, @my_secret.url, target: "_blank", class: "text-decoration-none" %>
          </div>
        <% end %>

        <% if @my_secret.username.present? %>
          <div class="mb-4">
            <h6 class="text-muted mb-2">Usuário</h6>
            <div class="input-group">
              <input type="text" class="form-control" value="<%= @my_secret.username %>" readonly>
              <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard(this)">
                <i class="fas fa-copy"></i>
              </button>
            </div>
          </div>
        <% end %>

        <% if @my_secret.password.present? %>
          <div class="mb-4">
            <h6 class="text-muted mb-2">Senha</h6>
            <div class="input-group">
              <input type="password" class="form-control" value="<%= @my_secret.password %>" readonly>
              <button class="btn btn-outline-secondary" type="button" onclick="togglePassword(this)">
                <i class="fas fa-eye"></i>
              </button>
              <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard(this)">
                <i class="fas fa-copy"></i>
              </button>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title">Informações</h5>
        <ul class="list-unstyled mb-0">
          <li class="mb-2">
            <small class="text-muted d-block">Criado em</small>
            <%= l(@my_secret.created_at, format: :long) %>
          </li>
          <li class="mb-2">
            <small class="text-muted d-block">Última atualização</small>
            <%= l(@my_secret.updated_at, format: :long) %>
          </li>
          <li>
            <small class="text-muted d-block">Categoria</small>
            <%= t("my_secrets.categories.#{@my_secret.category}") %>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>

<script>
function togglePassword(button) {
  const passwordField = button.parentElement.querySelector('input[type="password"]');
  const icon = button.querySelector('i');
  
  if (passwordField.type === "password") {
    passwordField.type = "text";
    icon.classList.remove("fa-eye");
    icon.classList.add("fa-eye-slash");
  } else {
    passwordField.type = "password";
    icon.classList.remove("fa-eye-slash");
    icon.classList.add("fa-eye");
  }
}

function copyToClipboard(button) {
  const input = button.parentElement.querySelector('input');
  input.select();
  document.execCommand('copy');
  
  // Feedback visual
  const originalIcon = button.innerHTML;
  button.innerHTML = '<i class="fas fa-check"></i>';
  setTimeout(() => {
    button.innerHTML = originalIcon;
  }, 1000);
}
</script> 